{
  "cli": {
    "version": ">= 7.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "developmentClient": true,
      "ios": {
        "simulator": true
      },
      "env": {
        "APP_VARIANT": "simulator",
        "NODE_ENV": "development"
      },
      "channel": "simulator"
    },
    "development": {
      "distribution": "internal",
      "developmentClient": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_APP_SCHEME": "linklaundry-dev"
      },
      "channel": "development"
    },
    "staging": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "staging",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "staging",
        "EXPO_PUBLIC_APP_SCHEME": "linklaundry-stage"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_APP_SCHEME": "linklaundry"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
