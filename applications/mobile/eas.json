{
  "cli": {
    "version": ">= 7.6.2"
  },
  "build": {
    "simulator": {
      "developmentClient": true,
      "ios": {
        "simulator": true
      },
      "env": {
        "NODE_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "preview"
      }
    },
    "staging": {
      "channel": "staging",
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
