{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "type-check": "tsc",
    "build-local-ios": "eas build --profile simulator-dev-local -p ios --local",
    "build-local-android": "eas build --profile simulator-dev-local -p android --local",
    "dev": "APP_VARIANT=simulator yarn expo",
    "lint": "run -T eslint ./src",
    "eas-build-post-install": "yarn workspace fk-shid-core compile"
  },
  "dependencies": {
    "@emotion/native": "^11.11.0",
    "@emotion/react": "^11.11.4",
    "@radix-ui/colors": "^3.0.0",
    "@types/react": "~19.2.10",
    "expo": "~55.0.24",
    "expo-build-properties": "~55.0.14",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.34",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-share-intent": "^6.1.0",
    "expo-sharing": "~55.0.19",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.22",
    "fk-shid-core": "workspace:^",
    "react": "19.2.0",
    "react-native": "0.83.6",
    "react-native-reanimated": "~4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-toast-message": "^2.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "radix-theme-generator": "^0.1.1",
    "react-native-worklets": "0.7.4"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
